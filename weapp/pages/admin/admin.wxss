/* pages/admin/admin.wxss */
.page { padding: 20rpx; }
.sec-tabs { display: flex; gap: 14rpx; margin-bottom: 16rpx; }
.sec { font-size: 28rpx; padding: 14rpx 30rpx; background: #fff; border-radius: 14rpx; color: #5b6470; }
.sec.on { background: #ff5b1e; color: #fff; font-weight: 700; }

.otabs { white-space: nowrap; margin-bottom: 16rpx; }
.otab { display: inline-block; font-size: 24rpx; padding: 10rpx 22rpx; margin-right: 12rpx; background: #fff; border-radius: 999rpx; color: #5b6470; }
.otab.on { background: #ff5b1e; color: #fff; }

.empty { text-align: center; color: #9aa2ac; margin-top: 100rpx; font-size: 28rpx; }
.order { padding: 22rpx; margin-bottom: 16rpx; }
.o-top { display: flex; justify-content: space-between; align-items: center; }
.o-code { font-size: 28rpx; font-weight: 700; }
.o-status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 999rpx; }
.s-pending { background: #fff7e6; color: #b06a00; }
.s-making { background: #e6f1fb; color: #185fa5; }
.s-ready { background: #eaf3de; color: #3b6d11; }
.s-done { background: #f1f3f6; color: #5b6470; }
.s-canceled { background: #f7dada; color: #a32d2d; }
.o-item { display: flex; justify-content: space-between; font-size: 26rpx; margin: 8rpx 0; }
.o-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; font-size: 24rpx; }
.o-remark { font-size: 22rpx; margin-top: 6rpx; }
.o-ops { display: flex; gap: 14rpx; margin-top: 14rpx; }
.op { padding: 12rpx 26rpx; border-radius: 12rpx; font-size: 26rpx; }
.op-cancel { background: #f1f3f6; color: #8a929c; }

.set { padding: 24rpx; margin-bottom: 20rpx; }
.set-h { font-size: 30rpx; font-weight: 700; margin: 8rpx 0 16rpx; }
.field { display: flex; align-items: center; margin: 14rpx 0; }
.label { width: 130rpx; font-size: 26rpx; color: #5b6470; }
.input { flex: 1; background: #f6f7f9; border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; }
.save { text-align: center; padding: 22rpx; margin-top: 18rpx; font-size: 28rpx; }
.prow { display: flex; align-items: center; padding: 18rpx; margin-bottom: 14rpx; }
.p-emoji { width: 80rpx; height: 80rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.p-info { flex: 1; margin-left: 16rpx; }
.p-name { font-size: 28rpx; font-weight: 600; }
