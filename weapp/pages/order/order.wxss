/* pages/order/order.wxss */
.page { padding: 20rpx; }
.tabs { display: flex; gap: 14rpx; margin-bottom: 16rpx; }
.tab { font-size: 26rpx; padding: 12rpx 26rpx; background: #fff; border-radius: 999rpx; color: #5b6470; }
.tab.on { background: #ff5b1e; color: #fff; font-weight: 700; }
.empty { text-align: center; color: #9aa2ac; margin-top: 120rpx; font-size: 28rpx; }
.order { padding: 22rpx; margin-bottom: 16rpx; }
.o-top { display: flex; justify-content: space-between; align-items: center; }
.o-code { font-size: 28rpx; font-weight: 700; }
.o-status { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.s-pending { background: #fff7e6; color: #b06a00; }
.s-making { background: #e6f1fb; color: #185fa5; }
.s-ready { background: #eaf3de; color: #3b6d11; }
.s-done { background: #f1f3f6; color: #5b6470; }
.s-canceled { background: #f7dada; color: #a32d2d; }
.o-item { display: flex; justify-content: space-between; font-size: 26rpx; margin: 10rpx 0; }
.o-name { color: #3a4150; }
.o-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 10rpx; font-size: 24rpx; }
.o-review { display: inline-block; margin-top: 14rpx; padding: 12rpx 28rpx; font-size: 26rpx; }
.o-reviewed { font-size: 24rpx; margin-top: 10rpx; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 100; display: flex; align-items: center; justify-content: center; }
.sheet { width: 86%; background: #fff; border-radius: 24rpx; padding: 30rpx; }
.sheet-h { font-size: 32rpx; font-weight: 700; margin-bottom: 20rpx; }
.stars { text-align: center; font-size: 56rpx; margin: 10rpx 0; }
.star { color: #d3d1c7; }
.star.on { color: #ffb400; }
.ta { width: 100%; height: 160rpx; background: #f6f7f9; border-radius: 14rpx; padding: 16rpx; font-size: 26rpx; margin: 12rpx 0; box-sizing: border-box; }
.sheet-btns { display: flex; gap: 16rpx; margin-top: 10rpx; }
.b-cancel { flex: 1; text-align: center; padding: 22rpx; border-radius: 14rpx; background: #eef0f3; color: #444; font-size: 28rpx; }
.b-ok { flex: 1; text-align: center; padding: 22rpx; font-size: 28rpx; }
